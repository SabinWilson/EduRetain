PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/eduretain
JWT_SECRET=eduretain-super-secret-production-jwt-key-2026
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT=4000
CLIENT_URL=http://localhost:5173
CRON_SCHEDULE=0 2 * * *
EMAIL_FROM="EduRetain Alerts" <alerts@institution.edu>
# Initial Admin Credentials (used by seeder)
ADMIN_EMAIL=admin@eduretain.com
ADMIN_PASSWORD=Admin@123
# Whether to seed ~200 sample students and 5 demo mentors (true/false)
SEED_DEMO_DATA=false

# Optional SMTP configuration (leave empty to simulate via server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

